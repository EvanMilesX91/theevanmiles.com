# Live mode never substitutes fictional data. APP_MODE=demo runs local fixtures.
APP_MODE=live
RUNTIME_MODE=server
AUTO_MIGRATE=true
WAYPOINT_SERVICE_TOKEN=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Default database lives at ./data/waypoint.db. Omit for SQLite.
# DATABASE_URL=postgresql+psycopg://waypoint:choose-a-local-password@127.0.0.1:5432/waypoint
FRONTEND_ORIGIN=http://127.0.0.1:3000
TICK_SECONDS=30
SCHEDULER_ENABLED=true
# Local live mode keeps one Alpaca WebSocket open in the Python process.
STREAM_ENABLED=true
MAX_HOT_SYMBOLS=30
PRICE_STALE_SECONDS=30
STREAM_PUBLISH_SECONDS=1
STATE_CHECKPOINT_SECONDS=30
WARM_REFRESH_MINUTES=15
ALPHA_VANTAGE_DAILY_LIMIT=25
MORNING_REFRESH_HOUR_ET=7
# The app calls only market-data endpoints. Use paper account keys.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
LIVE_SYMBOLS=AAPL,MSFT
# Required for SEC requests: identifying app name and your real contact email.
SEC_USER_AGENT=
# Optional: used only for the earnings calendar. It is not used for quotes or FX.
ALPHA_VANTAGE_API_KEY=
# Optional Docker PostgreSQL password; required if using compose.
POSTGRES_PASSWORD=
