# Live mode never substitutes fictional data. APP_MODE=demo runs local fixtures.
APP_MODE=live
RUNTIME_MODE=server
AUTO_MIGRATE=true
WAYPOINT_SERVICE_TOKEN=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Default database lives at ./data/waypoint.db. Omit for SQLite.
# DATABASE_URL=postgresql+psycopg://waypoint:choose-a-local-password@127.0.0.1:5432/waypoint
FRONTEND_ORIGIN=http://127.0.0.1:3000
TICK_SECONDS=30
SCHEDULER_ENABLED=true
# Local live mode keeps one Alpaca WebSocket open in the Python process.
STREAM_ENABLED=true
MAX_HOT_SYMBOLS=30
PRICE_STALE_SECONDS=30
STREAM_PUBLISH_SECONDS=1
STATE_CHECKPOINT_SECONDS=30
WARM_REFRESH_MINUTES=15
ALPHA_VANTAGE_DAILY_LIMIT=25
MORNING_REFRESH_HOUR_ET=7
# Optional ML subsystem. Keep shadow mode on until out-of-sample results improve after costs.
ML_ENABLED=false
ML_SHADOW_MODE=true
ML_INFLUENCE_ENABLED=false
ML_REGISTRY_PATH=data/ml_registry.json
ML_DATASET_PATH=data/ml_snapshots.jsonl
HISTORICAL_PROJECTION_ENABLED=true
HISTORICAL_PROJECTION_TOP_N=100
HISTORICAL_PROJECTION_RUNTIME_ROWS=500
HISTORICAL_PROJECTION_CACHE_SECONDS=30
# Optional persistent maintenance. It evaluates and registers candidates but never activates them.
ML_MAINTENANCE_ENABLED=false
ML_MAINTENANCE_INTERVAL_HOURS=168
ML_INGEST_YEARS=5
ML_INGEST_STRIDE_DAYS=5
# The app calls only market-data endpoints. Use paper account keys.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
LIVE_SYMBOLS=AAPL,MSFT
# Optional wider pre-market scan; combined with LIVE_SYMBOLS and capped at 100 symbols.
# SCAN_SYMBOLS=NVDA,AMD,AMZN,TSLA,META,GOOGL,PLTR,RKLB,CRWD,SOFI
# Required for SEC requests: identifying app name and your real contact email.
SEC_USER_AGENT=
# Optional: used only for the earnings calendar. It is not used for quotes or FX.
ALPHA_VANTAGE_API_KEY=
# GDELT discovery headlines are stored as unverified, timestamped evidence.
NEWS_GDELT_ENABLED=true
# Optional Docker PostgreSQL password; required if using compose.
POSTGRES_PASSWORD=
